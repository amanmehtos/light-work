{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "light-week",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // One Durable Object per account holds that account's whole task graph.
  // SQLite-backed, which is also the only backend available on the free plan.
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT", "class_name": "Account" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],

  // D1 holds only global auth rows: users, sessions, login codes. Keeping the
  // task graph out of D1 is deliberate — the free plan allows 100k row writes
  // per day across the account, and a sync-heavy app would spend that on task
  // edits alone. Durable Object storage has its own, separate allowance.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "light-week-auth",
      "database_id": "c13eddee-c4fd-466d-ad95-f10fe79cd633",
      "migrations_dir": "migrations"
    }
  ],

  // The web app ships from this same Worker. Static assets are served by
  // Cloudflare directly and are free and unmetered — only requests that
  // actually invoke the Worker count against the quota — so one deployment
  // costs nothing extra, needs no CORS, and leaves the app and the API on one
  // origin. `run_worker_first` lists the paths the API owns; everything else
  // falls through to the built SPA.
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    // Every exact path the API owns has to be listed as well as its subtree:
    // `/sync/*` does NOT match `/sync` itself, and a POST that falls through
    // to the asset server comes back 405.
    "run_worker_first": [
      "/auth/*",
      // OAuth for the MCP endpoint. Listed one path at a time rather than
      // "/oauth/*" on purpose: /oauth/consent is a page of the app, and a
      // wildcard here would hand it to the Worker, which has no such route.
      "/oauth/authorize",
      "/oauth/register",
      "/oauth/approve",
      "/oauth/token",
      // Discovery. Without this these fall through to the SPA, whose
      // single-page-application fallback answers 200 with index.html — so a
      // client asking whether we support OAuth got HTML and a success code.
      "/.well-known/*",
      "/sync",
      "/sync/*",
      "/account/*",
      "/mcp",
      "/mcp/*",
      "/healthz"
    ]
  },

  // Housekeeping: expire sessions and sign-in codes once a day.
  "triggers": { "crons": ["0 4 * * *"] },

  "observability": { "enabled": true }
}
