{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Light Week",
  "version": "0.1.0",
  "identifier": "app.lightweek.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @light/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @light/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Light Week",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 420,
        "resizable": true,
        "decorations": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "'self' https://api.lightweek.app wss://api.lightweek.app"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Productivity",
    "shortDescription": "Tasks, with focus as a first-class citizen.",
    "copyright": "MIT licensed"
  }
}
